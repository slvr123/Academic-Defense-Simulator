{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pip install *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(cat .env)",
      "Read(./.env)",
      "Edit(./.env)"
    ]
  }
}
